
flowchart TD
    subgraph User
        A1[Chat Interface (Streamlit)]
        A2[Upload Curriculum PDF (optional)]
    end

    subgraph Frontend
        A1 -->|Query, File| B1[Streamlit Handler]
        A2 --> B1
    end

    subgraph LangGraph Backend
        B1 --> C1[Main Graph Router]
        C1 -->|Keyword Routing| C2[Curriculum Agent]
        C1 -->|Job Query| C3[Job Market Agent]
        C1 -->|Skill Match| C4[Skill Mapping Agent]
        C1 -->|Books/Resources| C5[Books Agent]
        C1 -->|Fallback| C6[Fallback Agent]
    end

    subgraph Curriculum Agent
        C2 --> D1[Qdrant Vector Store]
        C2 --> D2[LangChain QA Chain]
    end

    subgraph Job Market Agent
        C3 --> E1[SerpAPI (Google Search)]
        C3 --> E2[GPT-4 Job Summary]
    end

    subgraph Skill Mapping Agent
        C4 --> F1[Curriculum Chunks (Qdrant or Uploaded)]
        C4 --> F2[Job Listings (JSON)]
        C4 --> F3[GPT-4 Skill Analysis]
        C4 --> F4[Knowledge Graph Engine (NetworkX)]
    end

    subgraph Books Agent
        C5 --> G1[SerpAPI - Book Search]
        C5 --> G2[GPT-4 Book Summarizer]
    end

    subgraph Fallback Agent
        C6 --> H1[Generic GPT-4 Response]
    end

    C2 --> I[Return Answer]
    C3 --> I
    C4 --> I
    C5 --> I
    C6 --> I
    I --> A1
